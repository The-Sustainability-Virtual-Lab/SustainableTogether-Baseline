package HomePVSystemModel {
    doc
    /* HomePV: a grid-tied residential photovoltaic system with battery storage,
     * modeled in SysML v2 with the SYSMOD method. Use it as a worked example of
     * the whole SYSMOD chain, from the problem statement to the physical
     * architecture.
     *
     * HOW TO READ IT. Every SYSMOD step is its own package inside the project
     * container HomePVSystemProject. Each package imports only the earlier
     * packages it needs:
     *   HPVS-ProblemSpace            Step 1 problem statement, Step 2 system idea
     *                                (base architecture), Step 3b stakeholder needs
     *   HPVS-Stakeholders            Step 3 stakeholders and elicitation priority
     *   HPVS-Requirements            Step 4 system requirements
     *   HPVS-ItemsDefinitions,
     *   HPVS-PortDefinitions,
     *   HPVS-Context                 Step 5 what crosses the boundary, where, and
     *                                with whom (system context and actors)
     *   HPVS-Functions, HPVS-UseCases  Step 6 use cases and their action flows
     *   HPVS-FunctionalBreakdown     Step 7a hierarchy of functions
     *   HPVS-FunctionalArchitecture  Step 7b functional parts and interfaces
     *   HPVS-LogicalArchitecture     Step 8 logical parts (with a small simulation)
     *   HPVS-PhysicalArchitecture    Step 9 physical components
     *
     * TRACEABILITY. Needs frame the problem statement, requirements frame the
     * needs, use cases refine the requirements, their actions use the
     * functions, functions are allocated to functional parts, functional parts
     * to logical parts, logical parts to physical components, and the physical
     * system satisfies the requirements.
     *
     * ONE SYSTEM, FOUR DESCRIPTIONS. HomePVSystem-BA (first structural outline),
     * -FA (functional), -LA (logical) and -PA (physical) describe the same
     * system of interest. They are four views of one system, not four systems. */
    private import SimplifiedSysMOD::*;
    private import ScalarValues::**;
    private import SI::**;
    occurrence def HomePVSystemProject {
        private import Views::asTreeDiagram;
        private import Views::asInterconnectionDiagram;
        package 'HPVS-ProblemSpace' {
            doc
            /* Steps 1, 2 and 3b (Problem Statement, System Idea, Stakeholder Needs):
             * why the system exists and what it is meant to be.
             * Design decisions:
             * - The problem statement is a concern, not a requirement: needs and
             *   requirements "frame" it, and frame only resolves against a concern.
             * - The system idea is the base architecture HomePVSystem-BA itself; there
             *   is no separate black-box system part. Its elevator pitch is the doc of
             *   the systemOfInterest in HPVS-Context.
             * - Each need is a concern in the stakeholder's own voice. All needs share
             *   one subject, theHousehold (the problem domain), and sit at the same
             *   level as problemStatement so that frame resolves. */
            private import 'HPVS-Stakeholders'::*;
            concern problemStatement {
                doc 
                /* Homeowners face steadily rising electricity costs while their
                 * household electricity is largely drawn from a grid mix that does
                 * not meet their expectations for renewable, low-CO2 energy. At the
                 * same time, available roof area remains unused as an energy
                 * resource. Full dependence on the grid exposes the household to
                 * price increases and leaves no ability to use self-generated
                 * energy. Homeowners need a way to cover a substantial share of
                 * their household electricity demand from their own renewable
                 * generation, store surplus energy for later self-consumption, and
                 * feed remaining surplus into the grid, while remaining
                 * grid-connected for shortfall periods. */
            }
            part def PVGenerationSystem {
                doc 
                /* PVGenerationSystem is the rooftop PV array: it converts solar
                 * irradiation into DC electricity. It is the generation building
                 * block of the base architecture; conversion, storage, grid
                 * exchange, and distribution are handled by the other subsystems. */
            }
            part def PowerConversionSubsystem {
                doc 
                /* PowerConversionSubsystem converts the DC electricity
                 * generated by the PV panels into AC electricity suitable
                 * for household use or grid integration. */
            }
            part def EnergyStorageSubsystem {
                doc 
                /* EnergyStorageSubsystem stores excess electricity generated
                 * by the PV system for later use, ensuring a stable power supply
                 * during periods of low solar irradiation. */
            }
            part def EnergyManagementSubsystem {
                doc 
                /* EnergyManagementSubsystem optimizes the distribution and utilization
                 * of electricity within the home, balancing consumption, storage,
                 * and grid interaction to maximize self-consumption and minimize grid dependency. */
            }
            part def GridConnectionSubsystem {
                doc 
                /* GridConnectionSubsystem facilitates the connection between the home's electrical
                 * system and the public power grid, enabling power export during surplus periods
                 * and import during shortfall periods. */
            }
            part def MonitoringSubsystem {
                doc 
                /* MonitoringSubsystem provides real-time data on the performance and status of
                 * the PV system, allowing homeowners to track energy production,
                 * consumption, and system health. */
            }
            part def <'HPVS-BA'> 'HomePVSystem-BA' {
                doc
                /* Base architecture (Step 2, System Idea): the first structural outline of
                 * the system as six peer subsystems. It is deliberately flat and coarse;
                 * the functional, logical and physical architectures refine it. The system
                 * of interest in the context is typed by it. */
                part pvGenerationSystem : PVGenerationSystem;
                part powerConversionSystem : PowerConversionSubsystem;
                part energyStorageSystem : EnergyStorageSubsystem;
                part energyManagementSystem : EnergyManagementSubsystem;
                part gridConnectionSystem : GridConnectionSubsystem;
                part monitoringSystem : MonitoringSubsystem;
            }
            part theHousehold {
                doc 
                /* The residential household and its current grid-only electricity
                 * situation — the problem domain the stakeholder needs concern. */
            }
            concern <'N-HO-1'> reduceElectricityCost {
                doc /* I want to spend less on electricity each month. */
                subject :> theHousehold;
                stakeholder :> homeowner;
                frame problemStatement;
            }
            concern <'N-HO-2'> useCleanEnergy {
                doc /* I want my electricity to be clean and to lower my carbon footprint. */
                subject :> theHousehold;
                stakeholder :> homeowner;
                frame problemStatement;
            }
            concern <'N-HO-3'> reduceGridDependence {
                doc /* I want to be less exposed to the grid and to rising electricity prices. */
                subject :> theHousehold;
                stakeholder :> homeowner;
                frame problemStatement;
            }
            concern <'N-HO-4'> seeSystemPerformance {
                doc /* I want to see what I generate, use, and save, so I trust the system. */
                subject :> theHousehold;
                stakeholder :> homeowner;
                frame problemStatement;
            }
            concern <'N-HO-5'> safeReliableLowMaintenance {
                doc /* I want the system to be safe, reliable, and low-maintenance. */
                subject :> theHousehold;
                stakeholder :> homeowner;
                frame problemStatement;
            }
            concern <'N-HM-1'> uninterruptedEverydayPower {
                doc /* We want electricity always available, with no disruption to daily life. */
                subject :> theHousehold;
                stakeholder :> householdMembers;
                frame problemStatement;
            }
            concern <'N-GO-1'> compliantGridConnection {
                doc /* The connection must follow our feed-in and metering rules and not disturb the grid. */
                subject :> theHousehold;
                stakeholder :> gridOperator;
                frame problemStatement;
            }
            concern <'N-IN-1'> safeServiceableInstallation {
                doc /* The system must be safe and standard-compliant to install, commission, and service. */
                subject :> theHousehold;
                stakeholder :> installer;
                frame problemStatement;
            }
            concern <'N-RA-1'> regulatoryCompliantInstallation {
                doc /* The installation must meet permitting, electrical-safety, and feed-in regulations. */
                subject :> theHousehold;
                stakeholder :> regulatoryAuthority;
                frame problemStatement;
            }
            view 'Problem Statement' : DS_Views::SymbolicViews::gv;
        }
        package 'HPVS-ItemsDefinitions' {
            doc
            /* Step 5: the things that cross the system boundary or move between parts.
             * Each item names a physically real quantity or a concrete piece of
             * information, never a field such as "electricity". General kinds are
             * specialized where a context needs it (DC/AC energy, grid exchange status). */
            item def SolarIrradiation {
                doc /* Solar radiation arriving on the roof surface: the system's primary energy input. */
            }
            item def ElectricalEnergy {
                doc
                /* Electrical energy in general. Specialized into DC and AC, because where the system converts between them is a design decision the model must show. */
            }
            item def DCElectricalEnergy :> ElectricalEnergy {
                doc
                /* DC energy as the PV modules produce it and the battery stores it. The energy decision is taken on the DC side. */
            }
            item def ACElectricalEnergy :> ElectricalEnergy {
                doc /* Grid-compatible AC energy, as the household uses it and the public grid exchanges it. */
            }
            item def MonitoringData {
                doc
                /* Current performance values: generation, consumption, storage level, feed-in and avoided CO2 (requirement provideMonitoring). */
            }
            item def MeasurementHistory {
                doc /* Monitoring data recorded over time, so past performance can be shown. */
            }
            item def ViewRequest {
                doc /* The homeowner's request to see performance. It triggers the visualization. */
            }
            item def GridConnectionCommand {
                doc
                /* The decision to connect to or isolate from the public grid (anti-islanding, requirement disconnectOnGridOutage). */
            }
            item def ConfigurationData {
                doc
                /* Settings the installer enters at commissioning. No function consumes it yet (use case 'commission the system' has no action flow). */
            }
            item def CommissioningReport {
                doc
                /* Report confirming correct operation after commissioning. No function produces it yet (use case 'commission the system' has no action flow). */
            }
            item def ExchangeStatus {
                doc
                /* Reading of an energy exchange: which direction the energy goes and how much. General on purpose; contexts narrow it. */
            }
            item def GridExchangeStatus :> ExchangeStatus {
                doc /* Exchange reading at the grid connection point: importing or exporting, and how much. */
            }
        }
        package 'HPVS-PortDefinitions' {
            doc
            /* Step 5: one port definition per system boundary. The system of interest
             * uses the plain port, the actor the conjugated one (~). The grid port is
             * inout because one physical connection carries energy both ways; the
             * household port is out only because the household only receives. */
            private import 'HPVS-ItemsDefinitions'::*;
            port def SunPort {
                doc /* Where solar irradiation enters the system. */
                in item irradiation : SolarIrradiation;
            }
            port def GridPort {
                doc
                /* The grid connection point: one AC connection, energy flows in both directions (surplus out, shortfall in). */
                inout item electricity : ACElectricalEnergy;
            }
            port def HouseholdPort {
                doc /* Where the household is supplied with AC energy. */
                out item electricity : ACElectricalEnergy;
            }
            port def HomeownerPort {
                doc /* The homeowner's interaction: a view request goes in, monitoring data comes out. */
                in item viewRequest : ViewRequest;
                out item data : MonitoringData;
            }
            port def InstallerPort {
                doc
                /* The installer's interaction at commissioning and service. Open finding:
                 * no function consumes ConfigurationData or produces CommissioningReport
                 * yet, so this port does not reach the functional architecture. */
                in item configuration : ConfigurationData;
                out item report : CommissioningReport;
            }
        }
        package 'HPVS-Context' {
            doc
            /* Step 5 (System Context & Actors). Design decisions:
             * - An actor that is also a stakeholder subsets that stakeholder by
             *   qualified name (household, homeowner, installer), which traces
             *   stakeholder -> actor. The interaction port sits on the actor, not on
             *   the stakeholder.
             * - The sun and the physical public grid are actors but not stakeholders,
             *   so they stand alone. The grid operator and the regulatory authority
             *   are stakeholders without a runtime interaction, so they have no actor.
             * - The interfaces live at the context level, not inside the system. */
            private import 'HPVS-ProblemSpace'::*;
            private import 'HPVS-PortDefinitions'::*;
            part systemContext {
                part sun {
                    doc /* Source of the solar irradiation the system converts. */
                    port radiationPort : ~SunPort;
                }
                part publicGrid {
                    doc 
                    /* The physical public grid the system exchanges energy with.
                     * Distinct from the gridOperator stakeholder, which has no
                     * direct runtime interaction port. */
                    port systemPort : ~GridPort;
                }
                part household :> 'HPVS-Stakeholders'::householdMembers {
                    doc /* The household members as actor: they receive the AC supply. */
                    port systemPort : ~HouseholdPort;
                }
                part homeowner :> 'HPVS-Stakeholders'::homeowner {
                    doc /* The homeowner as actor: requests and receives performance information. */
                    port systemPort : ~HomeownerPort;
                }
                part installer :> 'HPVS-Stakeholders'::installer {
                    doc /* The installer as actor: configures, commissions and services the system. */
                    port systemPort : ~InstallerPort;
                }
                part systemOfInterest : 'HomePVSystem-BA' {
                    doc 
                    /* HomePVSystem is a grid-tied residential photovoltaic system
                     * with battery storage, optimized for self-consumption. It
                     * converts solar irradiation on the roof into electricity for the
                     * household, stores midday surplus in a battery for evening use,
                     * and feeds remaining surplus into the public grid. An energy
                     * management capability decides at each moment whether generated
                     * power serves the household loads, charges the battery, or is
                     * exported, always prioritizing self-consumption. The household
                     * stays grid-connected to cover shortfalls. EV charging, heat-pump
                     * integration, and smart control of individual loads are out of
                     * scope. */
                    port sunPort : SunPort;
                    port gridPort : GridPort;
                    port householdPort : HouseholdPort;
                    port homeownerPort : HomeownerPort;
                    port installerPort : InstallerPort;
                }
                interface connect sun.radiationPort to systemOfInterest.sunPort;
                interface connect systemOfInterest.gridPort to publicGrid.systemPort;
                interface connect household.systemPort to systemOfInterest.householdPort;
                interface connect homeowner.systemPort to systemOfInterest.homeownerPort;
                interface connect installer.systemPort to systemOfInterest.installerPort;
                view 'System Context' : DS_Views::SymbolicViews::gv;
            }
        }
        package 'HPVS-Stakeholders' {
            doc
            /* Step 3 (Stakeholder Analysis). priority = risk * effort is the SYSMOD
             * elicitation priority: risk is the harm if a stakeholder is ignored,
             * effort the work needed to elicit their needs. It is not raw importance.
             * Levels start at low = 1; there is no "none" level, because a stakeholder
             * with no risk and no effort would not be modeled at all. */
            private import SimplifiedSysMOD::*;
            part homeowner : Stakeholder {
                doc 
                /* Primary decision-maker and bill-payer; also the project owner.
                 * Wants lower bills, green energy, and independence, in that order. */
                attribute :>> risk = LevelKind::high;
                attribute :>> effort = LevelKind::low;
                attribute :>> category = StakeholderCategoryKind::requirementOwner;
            }
            part householdMembers : Stakeholder {
                doc /* Consume the household electricity; care about comfort and reliability. */
                attribute :>> risk = LevelKind::medium;
                attribute :>> effort = LevelKind::low;
                attribute :>> category = StakeholderCategoryKind::user;
            }
            part gridOperator : Stakeholder {
                doc 
                /* Distribution system operator: feed-in rules, grid-connection
                 * compliance, and metering. */
                attribute :>> risk = LevelKind::high;
                attribute :>> effort = LevelKind::medium;
                attribute :>> category = StakeholderCategoryKind::other;
            }
            part installer : Stakeholder {
                doc 
                /* Installs, commissions, and maintains the system; owns safety
                 * and warranty concerns. */
                attribute :>> risk = LevelKind::high;
                attribute :>> effort = LevelKind::medium;
                attribute :>> category = StakeholderCategoryKind::expert;
            }
            part regulatoryAuthority : Stakeholder {
                doc /* Permits, electrical-safety standards, and the feed-in tariff scheme. */
                attribute :>> risk = LevelKind::high;
                attribute :>> effort = LevelKind::high;
                attribute :>> category = StakeholderCategoryKind::other;
            }
        }
        package 'HPVS-Requirements' {
            doc
            /* Step 4 (Requirements). Every requirement frames at least one stakeholder
             * need, which gives the trace need -> requirement. The subject of every
             * requirement is the system of interest, so only the system as a whole can
             * satisfy them (see the satisfy statements in HPVS-PhysicalArchitecture);
             * a single component cannot. */
            private import 'HPVS-ProblemSpace'::*;
            private import 'HPVS-Context'::*;
            requirement <'R-1'> prioritizeSelfConsumption {
                doc 
                /* The system shall serve household loads and charge the battery
                 * from self-generated energy before exporting any surplus. */
                subject :> systemContext.systemOfInterest;
                frame reduceElectricityCost;
                frame reduceGridDependence;
            }
            requirement <'R-2'> achieveSelfSufficiency {
                doc 
                /* The system shall cover at least 70% of the household's annual
                 * electricity demand (baseline ~4,000 kWh/yr) from own generation
                 * and storage. selfSufficiency = own-supplied demand / total demand. */
                subject :> systemContext.systemOfInterest;
                frame reduceElectricityCost;
                frame reduceGridDependence;
                attribute selfSufficiency : ScalarValues::Real;
                require constraint {
                    selfSufficiency >= 0.7
                }
            }
            requirement <'R-3'> exportSurplus {
                doc /* The system shall export remaining surplus energy to the grid. */
                subject :> systemContext.systemOfInterest;
                frame reduceElectricityCost;
            }
            requirement <'R-4'> generateFromSolar {
                doc /* The system shall generate electricity from solar irradiation on the roof. */
                subject :> systemContext.systemOfInterest;
                frame useCleanEnergy;
            }
            requirement <'R-6'> drawGridOnlyOnShortfall {
                doc 
                /* The system shall draw electricity from the grid only when own
                 * generation plus storage cannot meet demand. */
                subject :> systemContext.systemOfInterest;
                frame reduceGridDependence;
            }
            requirement <'R-7'> provideEveningAutonomy {
                doc 
                /* The system shall store midday surplus and supply evening
                 * household loads from the battery. */
                subject :> systemContext.systemOfInterest;
                frame reduceGridDependence;
                frame uninterruptedEverydayPower;
            }
            requirement <'R-8'> disconnectOnGridOutage {
                doc 
                /* During a grid outage the system shall disconnect from the grid
                 * (anti-islanding) and shall not provide backup power. Islanding
                 * and backup operation are out of scope. */
                subject :> systemContext.systemOfInterest;
                frame reduceGridDependence;
                frame compliantGridConnection;
            }
            requirement <'R-9'> manageEnergyIntelligently {
                doc 
                /* The system shall decide in real time whether generated power
                 * serves loads, charges the battery, or is exported, always
                 * favoring self-consumption. Decisions shall be smart: anticipating
                 * later demand (evening and night-time consumption) and seasonal
                 * variation in generation and load, scheduling battery charging
                 * and discharging accordingly. */
                subject :> systemContext.systemOfInterest;
                frame reduceElectricityCost;
            }
            requirement <'R-10'> provideMonitoring {
                doc 
                /* The system shall make generation, consumption, storage level,
                 * feed-in, and avoided CO2 visible to the homeowner. Avoided CO2 is
                 * computed from displaced grid electricity x grid emission factor
                 * (~380 g CO2/kWh). */
                subject :> systemContext.systemOfInterest;
                frame seeSystemPerformance;
                frame useCleanEnergy;
            }
            requirement <'R-11'> supplyReliably {
                doc 
                /* The system shall supply household loads reliably, without
                 * disruption to everyday use. */
                subject :> systemContext.systemOfInterest;
                frame uninterruptedEverydayPower;
                frame safeReliableLowMaintenance;
            }
            requirement <'R-12'> beSafeAndLowMaintenance {
                doc /* The system shall be safe and low-maintenance over its service life. */
                subject :> systemContext.systemOfInterest;
                frame safeReliableLowMaintenance;
                frame safeServiceableInstallation;
            }
            requirement <'R-13'> complyWithGridCode {
                doc 
                /* The system shall comply with the grid operator's connection,
                 * feed-in, and metering rules. */
                subject :> systemContext.systemOfInterest;
                frame compliantGridConnection;
            }
            requirement <'R-14'> complyWithElectricalSafety {
                doc /* The system shall comply with applicable electrical-safety standards. */
                subject :> systemContext.systemOfInterest;
                frame safeServiceableInstallation;
                frame regulatoryCompliantInstallation;
            }
            requirement <'R-15'> meetPermitting {
                doc /* The installed system shall meet local permitting requirements. */
                subject :> systemContext.systemOfInterest;
                frame regulatoryCompliantInstallation;
            }
            requirement <'R-16'> supportCommissioning {
                doc 
                /* The system shall let the installer configure and commission it
                 * and shall produce a commissioning report confirming correct
                 * operation. Backs the installer configuration/report flows on
                 * the InstallerPort. */
                subject :> systemContext.systemOfInterest;
                frame safeServiceableInstallation;
            }
            requirement <'R-17'> supportServicing {
                doc 
                /* The system shall provide diagnostic information and allow
                 * servicing of replaceable components without specialist
                 * disassembly, so it stays safe and low-maintenance over its
                 * service life. */
                subject :> systemContext.systemOfInterest;
                frame safeServiceableInstallation;
                frame safeReliableLowMaintenance;
            }
            view Requirements : DS_Views::TabularViews::rt {
                expose 'HPVS-Requirements'::**;
                filter hastype SysML::RequirementUsage;
            }
        }
        package 'HPVS-Functions' {
            doc
            /* Function definitions used by the use cases (Step 6) and the functional
             * breakdown (Step 7a). Design decisions:
             * - Functions are solution-neutral and have parameters, not ports. Ports
             *   only appear on parts in Step 7b.
             * - A definition says what a function is, a usage says where it happens:
             *   ReadExchange is general, and its usage readGridExchange narrows the
             *   item types by redefinition.
             * - The energy decision stays on the DC side. ConvertToAC is the single
             *   DC -> AC boundary.
             * - Controllers (CoordinateEnergyDistribution, MonitorSystemPerformance)
             *   are black boxes here.
             * - SupplyElectricalEnergy and CapturePerformanceData are the composite
             *   nodes of the Step 7a breakdown. */
            private import 'HPVS-ItemsDefinitions'::*;
            action def GenerateSolarElectricity {
                doc /* Generate DC electricity from incident solar irradiation. */
                in item irradiation : SolarIrradiation;
                out item output : DCElectricalEnergy;
            }
            action def ConvertToAC {
                doc 
                /* Convert DC electricity into household/grid-compatible AC. This is
                 * the single DC->AC boundary: it sits after coordination, on the
                 * path to the household, so the battery and coordinator stay DC. */
                in item input : DCElectricalEnergy;
                out item output : ACElectricalEnergy;
            }
            action def ReadExchange {
                doc 
                /* Measure an electrical energy exchange in transit and emit the
                 * reading: which way the energy is going and how much. The energy
                 * PASSES THROUGH — it enters, is measured, and leaves again
                 * unchanged (inout) — so the function sits in series in the path
                 * rather than consuming what it measures.
                 *
                 * DELIBERATELY GENERAL: the definition says what measuring an
                 * exchange is, not where it happens. The grid connection point is
                 * one context (usage readGridExchange); reading household
                 * consumption would be another, with the same definition. What is
                 * specific belongs in the usage, which narrows the item types by
                 * redefinition. */
                inout item energy : ElectricalEnergy;
                out item measurement : ExchangeStatus;
            }
            action def ExchangeACEnergy {
                doc 
                /* The system's AC connection point: it takes the converted AC,
                 * serves the household from it, and exchanges the balance with the
                 * public grid, surplus out and shortfall in. This is where energy
                 * actually crosses the grid boundary, which is why the grid port
                 * carries AC in both directions. Modeling decision: the connection
                 * point belongs to the system (the base architecture has a
                 * GridConnectionSubsystem, and the system must be able to meter and
                 * isolate it), so the household is served through it. */
                in item fromConverter : ACElectricalEnergy;
                out item toHousehold : ACElectricalEnergy;
                inout item gridEnergy : ACElectricalEnergy;
            }
            action def DisconnectFromGrid {
                doc 
                /* Isolate the system's AC output from the public grid on the
                 * coordinator's command, and reconnect when the grid returns. This
                 * function CARRIES OUT anti-islanding; the decision to do so is the
                 * coordinator's. Without it the requirement disconnectOnGridOutage
                 * (R-8) would be decided but never performed. */
                in item command : GridConnectionCommand;
            }
            action def StoreElectricalEnergy {
                doc 
                /* Charge the battery: absorb surplus DC electricity into storage.
                 * The charge path of the storage subsystem; retrieval is a separate
                 * function (RetrieveElectricalEnergy) because charging and discharging
                 * happen at different times and on distinct power-electronics paths. */
                in item charge : DCElectricalEnergy;
            }
            action def RetrieveElectricalEnergy {
                doc 
                /* Discharge the battery: draw stored DC electricity back out to cover
                 * demand. The discharge path of the storage subsystem, separate from
                 * StoreElectricalEnergy. */
                out item discharge : DCElectricalEnergy;
            }
            action def CoordinateEnergyDistribution {
                doc 
                /* The system's controller and decision-making brain: from the grid
                 * measurement and the available DC, it decides in real time whether
                 * generated power serves the household, charges the battery, or is
                 * exported — always favoring self-consumption — and it owns the
                 * grid-side decisions (feed-in limiting and anti-islanding). Works
                 * entirely in DC; conversion to AC happens after, on the toHousehold
                 * path. Grid energy flows via the household, outside this function;
                 * only the sensor reading enters. Kept as a BLACK BOX here — its
                 * internal sense/decide decomposition is deferred to the Functional
                 * Architecture (Step 7). */
                in item generatedPower : DCElectricalEnergy;
                in item fromBattery : DCElectricalEnergy;
                out item toHousehold : DCElectricalEnergy;
                out item toBattery : DCElectricalEnergy;
                in item gridExchange : GridExchangeStatus;
                out item gridConnectionCommand : GridConnectionCommand;
            }
            action def MonitorSystemPerformance {
                doc 
                /* Continuously observe the system's operation — PV generation,
                 * household consumption, battery state of charge, and grid feed-in —
                 * and present it to the homeowner as monitoring data, including
                 * avoided CO2 (displaced grid electricity x the grid emission factor,
                 * ~380 g CO2/kWh). Grid feed-in enters as the grid-sensor reading;
                 * generation, consumption, and storage level are observed internally.
                 * Kept as a BLACK BOX here (like the coordinator) — how each internal
                 * quantity is tapped is deferred to the Functional Architecture
                 * (Step 7). */
                in item gridStatus : GridExchangeStatus;
                out item data : MonitoringData;
            }
            action def RecordMeasurementData {
                doc 
                /* Continuously log the performance samples over time into a
                 * retrievable history, so past performance can be shown on
                 * request. Continuous. */
                in item sample : MonitoringData;
                out item history : MeasurementHistory;
            }
            action def VisualizeSystemPerformance {
                doc 
                /* On the homeowner's request (via the app), present the current
                 * performance together with the recorded history. Event-driven:
                 * fires per request, not continuously. The request input is its
                 * trigger; explicit accept/event mechanics are deferred (Step 7). */
                in item request : ViewRequest;
                in item current : MonitoringData;
                in item history : MeasurementHistory;
                out item display : MonitoringData;
            }
            action def SupplyElectricalEnergy {
                doc 
                /* Supply the household with electrical energy from its own solar
                 * generation, buffer the surplus, and give what is left to the
                 * grid. Traces to R-11 supplyReliably and R-1 prioritizeSelfConsumption,
                 * and to UC-1 and UC-2. Every function below occurs within it:
                 * generation, buffering, coordination and conversion continuously,
                 * grid sensing whenever the exchange has to be judged. This node
                 * OWNS readGridExchange. */
                action generateSolarElectricity : GenerateSolarElectricity;
                action storeElectricalEnergy : StoreElectricalEnergy;
                action retrieveElectricalEnergy : RetrieveElectricalEnergy;
                action convertToAC : ConvertToAC;
                action coordinateEnergyDistribution : CoordinateEnergyDistribution;
                action readGridExchange : ReadExchange {
                    inout item :>> energy : ACElectricalEnergy;
                    out item :>> measurement : GridExchangeStatus;
                }
                action exchangeACEnergy : ExchangeACEnergy;
                action disconnectFromGrid : DisconnectFromGrid;
            }
            action def CapturePerformanceData {
                doc 
                /* Obtain the system's performance data and retain it: observe the
                 * running system continuously and log the samples into a history.
                 * Traces to N-HO-4 seeSystemPerformance and R-10 provideMonitoring,
                 * and to UC-3. Grid feed-in is read with the same function the
                 * supply side owns, so it appears here as a REFERENCE usage, not a
                 * composite one: one definition, one owner, any number of
                 * references. */
                action monitorSystemPerformance : MonitorSystemPerformance;
                action recordMeasurementData : RecordMeasurementData;
                ref action readGridExchange : ReadExchange;
            }
        }
        package 'HPVS-UseCases' {
            doc
            /* Step 6 (Use Cases). Design decisions:
             * - Use cases refine requirements (#refinement); they do not satisfy them.
             *   Satisfaction is stated in Step 9.
             * - The action flows use flows only, without successions, because supply
             *   and monitoring run continuously rather than as sequences.
             * - Every function parameter is connected, and the actor ends match the
             *   Step 5 context ports in item type and direction.
             * Open finding: 'commission the system' and 'maintain and service the
             * system' have no action flow yet. That is why the requirements they refine
             * (electrical safety, permitting, commissioning, servicing) are not
             * satisfied by the physical architecture. */
            private import 'HPVS-Context'::*;
            private import 'HPVS-Requirements'::*;
            private import 'HPVS-ItemsDefinitions'::*;
            private import 'HPVS-Functions'::*;
            private import ModelingMetadata::*;
            use case <'UC-1'> 'supply the household with electricity' {
                subject theSystem :> systemContext.systemOfInterest;
                actor theHousehold :> systemContext.household;
                actor theSun :> systemContext.sun;
                actor theGrid :> systemContext.publicGrid;
                objective {
                    doc 
                    /* The homeowner's core reason for the system: keep the
                     * household continuously supplied with electricity, favoring
                     * self-generated and stored energy and drawing from the grid
                     * only on shortfall. Runs continuously once installed; choosing
                     * between solar, battery, and grid at each moment is internal
                     * behavior (Step 7), not a separate use case. */
                }
                #refinement dependency 
                        from 'supply the household with electricity'
                        to prioritizeSelfConsumption, achieveSelfSufficiency, generateFromSolar, drawGridOnlyOnShortfall, provideEveningAutonomy, manageEnergyIntelligently, supplyReliably;

                action generate : GenerateSolarElectricity;
                action convert : ConvertToAC;
                action readGridExchange : ReadExchange {
                    inout item :>> energy : ACElectricalEnergy;
                    out item :>> measurement : GridExchangeStatus;
                }
                action storeEnergy : StoreElectricalEnergy;
                action retrieveEnergy : RetrieveElectricalEnergy;
                action coordinate : CoordinateEnergyDistribution;
                action exchangeACEnergy : ExchangeACEnergy;
                flow from theSun.radiationPort.irradiation to generate.irradiation;
                flow from generate.output to coordinate.generatedPower;
                flow from theGrid.systemPort.electricity to readGridExchange.energy;
                flow from readGridExchange.energy to exchangeACEnergy.gridEnergy;
                flow from readGridExchange.measurement to coordinate.gridExchange;
                flow from coordinate.toHousehold to convert.input;
                flow from convert.output to exchangeACEnergy.fromConverter;
                flow from exchangeACEnergy.toHousehold to theHousehold.systemPort.electricity;
                flow from coordinate.toBattery to storeEnergy.charge;
                flow from retrieveEnergy.discharge to coordinate.fromBattery;
                view 'supply the household with electricityView' : DS_Views::SymbolicViews::afv;
            }
            use case <'UC-2'> 'provide electricity to the grid' {
                subject theSystem :> systemContext.systemOfInterest;
                actor theGrid :> systemContext.publicGrid;
                actor theHousehold :> systemContext.household;
                actor theSun :> systemContext.sun;
                objective {
                    doc 
                    /* The system-to-grid interaction the grid operator requires:
                     * surplus AC leaves via the household connection and flows on
                     * to the public grid within the operator's feed-in and metering
                     * limits, and on a grid outage the system disconnects its AC
                     * output (anti-islanding) rather than energizing a dead line.
                     * Drawing from the grid on shortfall is part of the continuous
                     * supply use case (UC-1), not this one. */
                }
                #refinement dependency from 'provide electricity to the grid' to exportSurplus, complyWithGridCode, disconnectOnGridOutage;
                action generate : GenerateSolarElectricity;
                action coordinate : CoordinateEnergyDistribution;
                action convert : ConvertToAC;
                action readGridExchange : ReadExchange {
                    inout item :>> energy : ACElectricalEnergy;
                    out item :>> measurement : GridExchangeStatus;
                }
                action storeEnergy : StoreElectricalEnergy;
                action retrieveEnergy : RetrieveElectricalEnergy;
                action exchangeACEnergy : ExchangeACEnergy;
                action disconnectFromGrid : DisconnectFromGrid;
                flow from theSun.radiationPort.irradiation to generate.irradiation;
                flow from generate.output to coordinate.generatedPower;
                flow from readGridExchange.measurement to coordinate.gridExchange;
                flow from coordinate.toBattery to storeEnergy.charge;
                flow from retrieveEnergy.discharge to coordinate.fromBattery;
                flow from coordinate.toHousehold to convert.input;
                flow from convert.output to exchangeACEnergy.fromConverter;
                flow from exchangeACEnergy.toHousehold to theHousehold.systemPort.electricity;
                flow from exchangeACEnergy.gridEnergy to readGridExchange.energy;
                flow from readGridExchange.energy to theGrid.systemPort.electricity;
                flow from coordinate.gridConnectionCommand to disconnectFromGrid.command;
                view 'provide electricity to the gridView' : DS_Views::SymbolicViews::afv;
            }
            use case <'UC-3'> 'monitor system performance' {
                subject theSystem :> systemContext.systemOfInterest;
                actor theHomeowner :> systemContext.homeowner;
                actor theGrid :> systemContext.publicGrid;
                objective {
                    doc 
                    /* The homeowner checks generation, consumption, storage level,
                     * feed-in, and avoided CO2 to understand and trust the system. */
                }
                #refinement dependency from 'monitor system performance' to provideMonitoring;
                action monitor : MonitorSystemPerformance;
                action record : RecordMeasurementData;
                action visualize : VisualizeSystemPerformance;
                action readGridExchange : ReadExchange {
                    inout item :>> energy : ACElectricalEnergy;
                    out item :>> measurement : GridExchangeStatus;
                }
                flow from theGrid.systemPort.electricity to readGridExchange.energy;
                flow from readGridExchange.measurement to monitor.gridStatus;
                flow from monitor.data to record.sample;
                flow from monitor.data to visualize.current;
                flow from record.history to visualize.history;
                flow from theHomeowner.systemPort.viewRequest to visualize.request;
                flow from visualize.display to theHomeowner.systemPort.data;
                view 'monitor system performanceView' : DS_Views::SymbolicViews::afv;
            }
            use case <'UC-4'> 'commission the system' {
                subject theSystem :> systemContext.systemOfInterest;
                actor theInstaller :> systemContext.installer;
                objective {
                    doc 
                    /* The installer installs, configures, and commissions the
                     * system to a safe, standard-compliant, permitted state and
                     * confirms correct operation. */
                }
                #refinement dependency from 'commission the system' to complyWithElectricalSafety, meetPermitting, supportCommissioning;
            }
            use case <'UC-5'> 'maintain and service the system' {
                subject theSystem :> systemContext.systemOfInterest;
                actor theInstaller :> systemContext.installer;
                objective {
                    doc 
                    /* The installer services and maintains the system over its
                     * life, using diagnostics to keep it safe, reliable, and
                     * low-maintenance. */
                }
                #refinement dependency from 'maintain and service the system' to beSafeAndLowMaintenance, supportServicing;
            }
            view UseCases : DS_Views::SymbolicViews::gv;
        }
        package 'HPVS-FunctionalBreakdown' {
            doc
            /* Step 7a (Functional Breakdown): a forest of three root functions, with no
             * umbrella node. supplyElectricalEnergy and capturePerformanceData run
             * continuously; visualizeSystemPerformance runs on the homeowner's request,
             * independently of both, so it is a root of its own. readGridExchange is
             * owned by the supply function and only referenced (ref action) by the
             * capture function: one definition, one owner, any number of references. */
            private import 'HPVS-Functions'::*;
            action supplyElectricalEnergy : SupplyElectricalEnergy;
            action capturePerformanceData : CapturePerformanceData;
            action visualizeSystemPerformance : VisualizeSystemPerformance;
            view FunctionalBreakdown : DS_Views::SymbolicViews::gv;
        }
        package 'HPVS-FunctionalArchitecture' {
            doc
            /* Step 7b (Functional Architecture). Functional parts are solution-neutral
             * blocks of responsibility, named as doers. Assigning functions to parts is
             * the only decision in this step; everything else is derived from it:
             * - A use case flow between two functions in the same part stays internal.
             * - A flow crossing two parts gives each part a port and creates one
             *   interface per part pair.
             * - Port definitions are named after what they carry (DCPort, ACPort), not
             *   after who uses them.
             * - Boundary ports reuse the Step 5 port definitions, so a mismatch with
             *   the context is a validator error, not a comment.
             * - The grid sensor is its own part: observing is not acting.
             * The InstallerPort is missing from HomePVSystem-FA on purpose. No function
             * serves it yet (see HPVS-UseCases). */
            private import 'HPVS-ItemsDefinitions'::*;
            private import 'HPVS-PortDefinitions'::*;
            private import 'HPVS-Functions'::*;
            private import 'HPVS-FunctionalBreakdown'::*;
            port def DCPort {
                doc
                /* One-way DC energy, from producer to consumer. energyProduced carries the produced energy for the Step 8 simulation. */
                out item dc : DCElectricalEnergy;
                out attribute energyProduced;
            }
            port def DCExchangePort {
                doc /* DC energy in both directions over one connection: charging and discharging the battery. */
                inout item dc : DCElectricalEnergy;
            }
            port def ACPort {
                doc /* One-way AC energy, from the converter to the connection point. */
                out item ac : ACElectricalEnergy;
            }
            port def ACExchangePort {
                doc /* AC energy in both directions over one connection: the grid side of the connection point. */
                inout item ac : ACElectricalEnergy;
            }
            port def GridStatusPort {
                doc
                /* The grid exchange reading, fanned out to everyone who needs it. energyConsumed carries the consumption for the Step 8 simulation. */
                out item status : GridExchangeStatus;
                out attribute energyConsumed;
            }
            port def GridCommandPort {
                doc /* The connect/isolate command from the deciding part to the switching part. */
                out item command : GridConnectionCommand;
            }
            port def PerformanceDataPort {
                doc /* Current monitoring data and recorded history, from the recorder to the presenter. */
                out item current : MonitoringData;
                out item history : MeasurementHistory;
            }
            part def SolarGenerator {
                doc /* Turns incident solar irradiation into DC electrical energy. */
                port sunPort : SunPort;
                port dcOut : DCPort;
            }
            part def PowerConverter {
                doc 
                /* Converts DC into household- and grid-compatible AC. The single
                 * DC-to-AC boundary of the system. */
                port dcIn : ~DCPort;
                port acOut : ACPort;
            }
            part def EnergyAccumulator {
                doc 
                /* Holds DC energy over time: absorbs surplus and gives it back
                 * later. Charging and discharging are two directions of one and
                 * the same store, so they are one part. */
                port dcPort : ~DCExchangePort;
            }
            part def EnergyCoordinator {
                doc 
                /* Decides where the DC energy goes at each moment, and decides when
                 * to isolate from the grid. Every energy path of the system runs
                 * through this decision, which is why five of the nine interfaces
                 * meet here. */
                port dcIn : ~DCPort;
                port dcOut : DCPort;
                port dcBuffer : DCExchangePort;
                port statusIn : ~GridStatusPort;
                port commandOut : GridCommandPort;
            }
            part def GridExchangeSensor {
                doc 
                /* Measures the AC energy crossing the grid connection point and
                 * reports whether the system is exporting or importing. A SENSOR:
                 * it measures and passes the energy on unchanged, it neither
                 * carries nor switches it, so it is its own part and not a
                 * function of the connection point. It sits at the grid boundary,
                 * in series ahead of the connector. */
                port gridPort : GridPort;
                port acPort : ACExchangePort;
                port statusOut : GridStatusPort;
            }
            part def GridConnector {
                doc 
                /* The system's AC connection point: it takes the converted AC and
                 * the measured grid energy, serves the household, passes the
                 * surplus on to the grid, and isolates the system from the grid on
                 * the coordinator's command. */
                port acGrid : ~ACExchangePort;
                port acIn : ~ACPort;
                port householdPort : HouseholdPort;
                port commandIn : ~GridCommandPort;
            }
            part def PerformanceMonitor {
                doc 
                /* Observes the running system and retains what it observed:
                 * observation and recording are one continuous data stream. */
                port statusIn : ~GridStatusPort;
                port dataOut : PerformanceDataPort;
            }
            part def PerformanceVisualizer {
                doc 
                /* Presents current performance and recorded history to the
                 * homeowner on request. Separate from the monitor: it is the only
                 * part facing the homeowner, it runs on its own trigger, and Step 8
                 * will plausibly put it on a different logical part. */
                port dataIn : ~PerformanceDataPort;
                port homeownerPort : HomeownerPort;
            }
            part def <'HPVS-FA'> 'HomePVSystem-FA' {
                doc 
                /* The system of interest seen through its functional decomposition.
                 * Structurally the same system is 'HomePVSystem-BA'; Step 8 allocates
                 * these functional parts to logical parts. */
                port sunPort : SunPort;
                port gridPort : GridPort;
                port householdPort : HouseholdPort;
                port homeownerPort : HomeownerPort;
                part solarGenerator : SolarGenerator;
                part powerConverter : PowerConverter;
                part energyAccumulator : EnergyAccumulator;
                part energyCoordinator : EnergyCoordinator;
                part gridExchangeSensor : GridExchangeSensor;
                part gridConnector : GridConnector;
                part performanceMonitor : PerformanceMonitor;
                part performanceVisualizer : PerformanceVisualizer;
                interface connect solarGenerator.dcOut to energyCoordinator.dcIn;
                interface connect energyCoordinator.dcOut to powerConverter.dcIn;
                interface connect powerConverter.acOut to gridConnector.acIn;
                interface connect energyCoordinator.dcBuffer to energyAccumulator.dcPort;
                interface connect gridExchangeSensor.acPort to gridConnector.acGrid;
                interface connect gridExchangeSensor.statusOut to energyCoordinator.statusIn;
                interface connect gridExchangeSensor.statusOut to performanceMonitor.statusIn;
                interface connect energyCoordinator.commandOut to gridConnector.commandIn;
                interface connect performanceMonitor.dataOut to performanceVisualizer.dataIn;
                binding bind sunPort = solarGenerator.sunPort;
                binding bind gridPort = gridExchangeSensor.gridPort;
                binding bind householdPort = gridConnector.householdPort;
                binding bind homeownerPort = performanceVisualizer.homeownerPort;
            }
            part homePVSystem : 'HomePVSystem-FA' {
                view homePVSystemView : DS_Views::SymbolicViews::iv;
            }
            allocation allocate supplyElectricalEnergy.generateSolarElectricity to homePVSystem.solarGenerator;
            allocation allocate supplyElectricalEnergy.convertToAC to homePVSystem.powerConverter;
            allocation allocate supplyElectricalEnergy.storeElectricalEnergy to homePVSystem.energyAccumulator;
            allocation allocate supplyElectricalEnergy.retrieveElectricalEnergy to homePVSystem.energyAccumulator;
            allocation allocate supplyElectricalEnergy.coordinateEnergyDistribution to homePVSystem.energyCoordinator;
            allocation allocate supplyElectricalEnergy.readGridExchange to homePVSystem.gridExchangeSensor;
            allocation allocate supplyElectricalEnergy.exchangeACEnergy to homePVSystem.gridConnector;
            allocation allocate supplyElectricalEnergy.disconnectFromGrid to homePVSystem.gridConnector;
            allocation allocate capturePerformanceData.monitorSystemPerformance to homePVSystem.performanceMonitor;
            allocation allocate capturePerformanceData.recordMeasurementData to homePVSystem.performanceMonitor;
            allocation allocate visualizeSystemPerformance to homePVSystem.performanceVisualizer;
        }
        package 'HPVS-LogicalArchitecture' {
            doc
            /* Step 8 (Logical Architecture). Logical parts commit to a technical
             * principle (Inverter, EnergyMeter) but never to a product. In this model
             * each functional part is allocated to exactly one logical part. The names
             * differ on purpose so that the two layers stay distinguishable.
             * The package also holds a small executable simulation, used to
             * demonstrate the behaviour:
             * - SolarEnvironment varies the irradiance.
             * - photovoltaicGenerator turns it into produced energy.
             * - energyMeter accumulates the household consumption.
             * - energyManager compares the two and sends Connect or Disconnect.
             * - gridInterconnector follows those commands.
             * The simulation values are dimensionless demonstrator numbers, not
             * datasheet values. */
            private import 'HPVS-ItemsDefinitions'::*;
            private import 'HPVS-PortDefinitions'::*;
            private import 'HPVS-Functions'::*;
            private import 'HPVS-FunctionalArchitecture'::DCPort;
            private import 'HPVS-FunctionalArchitecture'::DCExchangePort;
            private import 'HPVS-FunctionalArchitecture'::ACPort;
            private import 'HPVS-FunctionalArchitecture'::ACExchangePort;
            private import 'HPVS-FunctionalArchitecture'::GridStatusPort;
            private import 'HPVS-FunctionalArchitecture'::GridCommandPort;
            private import 'HPVS-FunctionalArchitecture'::PerformanceDataPort;
            part def PhotovoltaicGenerator {
                doc 
                /* Realizes the solar generation: it turns incident irradiation into
                 * DC electrical energy. Commits to the photovoltaic principle, not
                 * to a panel product. */
                port sunPort : SunPort;
                port dc : DCPort;
                perform action generateSolarElectricity : GenerateSolarElectricity;
            }
            part def Inverter {
                doc 
                /* Realizes the DC-to-AC conversion, the single conversion boundary
                 * of the system. */
                port dcIn : ~DCPort;
                port acOut : ACPort;
                perform action convertToAC : ConvertToAC;
            }
            part def Accumulator {
                doc 
                /* Realizes the energy buffer: it absorbs DC energy and gives it back
                 * later. One connection carries both directions, because charging
                 * and discharging are the same store. */
                port dcPort : ~DCExchangePort;
                perform action storeElectricalEnergy : StoreElectricalEnergy;
                perform action retrieveElectricalEnergy : RetrieveElectricalEnergy;
            }
            part def EnergyManager {
                doc 
                /* Realizes the energy decision: where the DC energy goes at each
                 * moment, and when to isolate from the grid. */
                port dc : ~DCPort;
                port dcOut : DCPort;
                port dcBuffer : DCExchangePort;
                port status : ~GridStatusPort;
                port commandOut : GridCommandPort {
                    out item Connect;
                    out item Disconnect;
                }
                perform action coordinateEnergyDistribution : CoordinateEnergyDistribution;
            }
            part def EnergyMeter {
                doc 
                /* Realizes the measurement at the grid connection point. Kept apart
                 * from the interconnector for the same reason the sensor is its own
                 * functional part: measuring and switching are two different devices
                 * in reality, one reads, one acts. */
                port gridPort : GridPort;
                port acPort : ACExchangePort;
                port status : GridStatusPort;
                perform action readGridExchange : ReadExchange;
            }
            part def GridInterconnector {
                doc 
                /* Realizes the AC connection point: it serves the household from the
                 * converted AC, passes the surplus on to the grid, and isolates the
                 * system on the manager's command. */
                port acGrid : ~ACExchangePort;
                port acIn : ~ACPort;
                port householdPort : HouseholdPort;
                port commandIn : ~GridCommandPort {
                    in item Connect;
                    in item Disconnect;
                }
                perform action exchangeACEnergy : ExchangeACEnergy;
                perform action disconnectFromGrid : DisconnectFromGrid;
            }
            part def PerformanceTracker {
                doc 
                /* Realizes the observation of the running system and the retention of
                 * what was observed: tracking is watching continuously AND keeping the
                 * record, which is exactly the pair of functions allocated here. */
                port statusIn : ~GridStatusPort;
                port dataOut : PerformanceDataPort;
                perform action monitorSystemPerformance : MonitorSystemPerformance;
                perform action recordMeasurementData : RecordMeasurementData;
            }
            part def PerformancePresenter {
                doc 
                /* Realizes the presentation to the homeowner on request. Separate from
                 * the tracker: it is the only logical part facing the homeowner and it
                 * runs on its own trigger. */
                port dataIn : ~PerformanceDataPort;
                port homeownerPort : HomeownerPort;
                perform action visualizeSystemPerformance : VisualizeSystemPerformance;
            }
            part def SolarEnvironment {
                doc
                /* Simulation stand-in for the sun, not part of the system. The irradiance
                 * rises in steps of 0.2 per second up to maxLevel, then falls back to
                 * minLevel, and so on, to emulate a varying solar input. */
                attribute irradiance : Integer := 0.5;
                attribute minLevel : Integer = 0.5;
                attribute maxLevel : Integer = 3;
                exhibit state irradianceSTM {
                    state rising {
                        entry action assign irradiance := irradiance + 0.2;
                    }
                    state falling {
                        entry action assign irradiance := irradiance - 0.2;
                    }
                    transition first start then rising;
                    transition first rising accept after 1 [s] then rising;
                    transition first rising accept when irradiance >= maxLevel then falling;
                    transition first falling accept after 1 [s] then falling;
                    transition first falling accept when irradiance <= minLevel then rising;
                }
            }
            part def <'HPVS-LA'> 'HomePVSystem-LA' {
                private import 'HPVS-LogicalArchitecture'::**;
                doc 
                /* The system of interest seen through its logical decomposition.
                 * 'HomePVSystem-FA' shows the same system functionally and
                 * 'HomePVSystem-BA' structurally; Step 9 turns these logical parts
                 * into physical components, where several of them will end up in one
                 * device. */
                port sunPort : SunPort;
                port gridPort : GridPort;
                port householdPort : HouseholdPort;
                port homeownerPort : HomeownerPort;
                part photovoltaicGenerator : PhotovoltaicGenerator {
                    doc
                    /* Simulation: pvPower = irradiance * panelArea * efficiency, added to
                     * dc.energyProduced every second. */
                    part environment : SolarEnvironment;
                    attribute panelArea : Real = 10;
                    attribute efficiency : Real = 0.4;
                    attribute pvPower : Real := environment.irradiance * panelArea * efficiency;
                    exhibit state pvGeneratorSTM {
                        state GenerateElectricPower {
                            entry action assign dc.energyProduced := dc.energyProduced + pvPower * 1;
                        }
                        accept after 1 [s] then GenerateElectricPower;
                        transition first start then GenerateElectricPower;
                    }
                }
                part inverter : Inverter;
                part accumulator : Accumulator;
                part energyManager : EnergyManager {
                    doc
                    /* Simulation of the energy decision: while accumulated consumption exceeds
                     * accumulated production it commands Connect, otherwise Disconnect. */
                    exhibit state EnergyManagerSTM {
                        state Connect {
                            entry action send new 'HPVS-LogicalArchitecture'::Connect() via commandOut;
                        }
                        state Disconnect {
                            entry action send new 'HPVS-LogicalArchitecture'::Disconnect() via commandOut;
                        }
                        transition first Connect accept when status.energyConsumed <= dc.energyProduced then Disconnect;
                        transition first Disconnect accept when status.energyConsumed > dc.energyProduced then Connect;
                        transition first start then Connect;
                    }
                }
                part energyMeter : EnergyMeter {
                    doc /* Simulation: adds totalLoadPower to status.energyConsumed every second. */
                    attribute totalLoadPower : Real = 1.5;
                    exhibit state EnergyMeterSTM {
                        state MeasureEnergyConsumed {
                            entry action assign status.energyConsumed := status.energyConsumed + totalLoadPower * 1;
                        }
                        accept after 1 [s] then MeasureEnergyConsumed;
                        transition first start then MeasureEnergyConsumed;
                    }
                }
                part gridInterconnector : GridInterconnector {
                    doc
                    /* Simulation: switches between connected and disconnected on the manager's Connect and Disconnect commands. */
                    exhibit state Gridinterconnector_STM {
                        state ConnectToGrid;
                        state DisconnectFromGrid;
                        transition first ConnectToGrid accept Disconnect then DisconnectFromGrid;
                        transition first DisconnectFromGrid accept Connect then ConnectToGrid;
                        transition first start then ConnectToGrid;
                    }
                }
                part performanceTracker : PerformanceTracker;
                part performancePresenter : PerformancePresenter;
                interface : PVGeneratorToEnergyManager connect photovoltaicGenerator.dc to energyManager.dc;
                interface connect energyManager.dcOut to inverter.dcIn;
                interface connect inverter.acOut to gridInterconnector.acIn;
                interface connect energyManager.dcBuffer to accumulator.dcPort;
                interface connect energyMeter.acPort to gridInterconnector.acGrid;
                interface : EnergyMeterToEnergyManager connect energyMeter.status to energyManager.status;
                interface connect energyMeter.status to performanceTracker.statusIn;
                interface connect energyManager.commandOut to gridInterconnector.commandIn;
                interface connect performanceTracker.dataOut to performancePresenter.dataIn;
                binding bind sunPort = photovoltaicGenerator.sunPort;
                binding bind gridPort = energyMeter.gridPort;
                binding bind householdPort = gridInterconnector.householdPort;
                binding bind homeownerPort = performancePresenter.homeownerPort;
                view 'HomePVSystem-LAView' : DS_Views::SymbolicViews::gv;
            }
            part homePVSystem : 'HomePVSystem-LA' {
                view LogicalArchitecture : DS_Views::SymbolicViews::iv;
                view 'State Machine' : DS_Views::SymbolicViews::gv;
            }
            allocation allocate 'HPVS-FunctionalArchitecture'::homePVSystem.solarGenerator to homePVSystem.photovoltaicGenerator;
            allocation allocate 'HPVS-FunctionalArchitecture'::homePVSystem.powerConverter to homePVSystem.inverter;
            allocation allocate 'HPVS-FunctionalArchitecture'::homePVSystem.energyAccumulator to homePVSystem.accumulator;
            allocation allocate 'HPVS-FunctionalArchitecture'::homePVSystem.energyCoordinator to homePVSystem.energyManager;
            allocation allocate 'HPVS-FunctionalArchitecture'::homePVSystem.gridExchangeSensor to homePVSystem.energyMeter;
            allocation allocate 'HPVS-FunctionalArchitecture'::homePVSystem.gridConnector to homePVSystem.gridInterconnector;
            allocation allocate 'HPVS-FunctionalArchitecture'::homePVSystem.performanceMonitor to homePVSystem.performanceTracker;
            allocation allocate 'HPVS-FunctionalArchitecture'::homePVSystem.performanceVisualizer to homePVSystem.performancePresenter;
            item def Connect {
                doc
                /* Command signal of the simulation: the EnergyManager tells the GridInterconnector to connect to the grid. */
            }
            item def Disconnect {
                doc
                /* Command signal of the simulation: the EnergyManager tells the GridInterconnector to disconnect from the grid. */
            }
            interface def PVGeneratorToEnergyManager {
                doc
                /* Carries the produced energy from the PV generator to the energy manager for the simulation. */
                end p1 : DCPort;
                end p2 : ~DCPort;
                flow from p1.energyProduced to p2.energyProduced;
            }
            interface def EnergyMeterToEnergyManager {
                doc
                /* Carries the measured consumption from the energy meter to the energy manager for the simulation. */
                end p1 : GridStatusPort;
                end p2 : ~GridStatusPort;
                flow from p1.energyConsumed to p2.energyConsumed;
            }
        }
        package 'HPVS-PhysicalArchitecture' {
            doc
            /* Step 9 (Physical Architecture). Components are named as the things they
             * are, not as doers. The only decision is which logical parts are deployed
             * together in one device:
             * - PhotovoltaicArray        <- PhotovoltaicGenerator
             * - Energyhub (hybrid inverter) <- Inverter, EnergyManager, GridInterconnector
             * - LFPBatteryTower          <- Accumulator
             * - SmartMeter               <- EnergyMeter
             * - MonitoringGateway        <- PerformanceTracker
             * - MobileApp                <- PerformancePresenter
             * Consequences: the logical interfaces between the inverter, the energy
             * manager and the grid interconnector are now inside the Energyhub, so
             * ACPort and GridCommandPort no longer appear between components. The
             * battery is DC-coupled to the Energyhub, so stored energy is converted
             * only once. The smart meter is a device of its own because it is the
             * billing point the grid operator owns. */
            private import 'HPVS-ItemsDefinitions'::*;
            private import 'HPVS-PortDefinitions'::*;
            private import 'HPVS-Requirements'::*;
            private import 'HPVS-FunctionalArchitecture'::DCPort;
            private import 'HPVS-FunctionalArchitecture'::DCExchangePort;
            private import 'HPVS-FunctionalArchitecture'::ACExchangePort;
            private import 'HPVS-FunctionalArchitecture'::GridStatusPort;
            private import 'HPVS-FunctionalArchitecture'::PerformanceDataPort;
            part def PVModule {
                doc /* One photovoltaic module. Replaceable unit of the array. */
            }
            part def BatteryModule {
                doc 
                /* One battery module. Replaceable unit of the storage; capacity is
                 * scaled by their number. */
            }
            part def PhotovoltaicArray {
                doc 
                /* The roof array: modules wired into strings. Realizes the
                 * PhotovoltaicGenerator. */
                part modules : PVModule [1..*];
                port sunPort : SunPort;
                port dcOut : DCPort;
            }
            part def Energyhub {
                doc 
                /* One device holding three logical parts: the Inverter, the
                 * EnergyManager and the GridInterconnector. DC-coupled: the battery
                 * hangs on its DC side, so stored energy passes the conversion once.
                 * The household is served from its AC output. */
                port dcIn : ~DCPort;
                port dcBuffer : DCExchangePort;
                port acGrid : ~ACExchangePort;
                port statusIn : ~GridStatusPort;
                port householdPort : HouseholdPort;
            }
            part def LFPBatteryTower {
                doc 
                /* The DC-coupled battery: modules plus their management. Realizes
                 * the Accumulator. */
                part modules : BatteryModule [1..*];
                port dcPort : ~DCExchangePort;
            }
            part def SmartMeter {
                doc 
                /* The billing-relevant meter at the grid connection point: it passes
                 * the AC energy and reports the exchange. Realizes the EnergyMeter.
                 * A device of its own, not a feature of the inverter, because it is
                 * the point the grid operator owns. */
                port gridPort : GridPort;
                port acPort : ACExchangePort;
                port statusOut : GridStatusPort;
            }
            part def MonitoringGateway {
                doc 
                /* The device that observes and records: realizes the
                 * PerformanceTracker. */
                port statusIn : ~GridStatusPort;
                port dataOut : PerformanceDataPort;
            }
            part def MobileApp {
                doc 
                /* The homeowner's app: realizes the PerformancePresenter. A component
                 * of its own because it runs on the homeowner's device, not on the
                 * system's hardware. */
                port dataIn : ~PerformanceDataPort;
                port homeownerPort : HomeownerPort;
            }
            part def <'HPVS-PA'> 'HomePVSystem-PA' {
                doc 
                /* The system of interest as built: six components. The same system
                 * is 'HomePVSystem-LA' logically, 'HomePVSystem-FA' functionally and
                 * 'HomePVSystem-BA' as the first structural outline. */
                port sunPort : SunPort;
                port gridPort : GridPort;
                port householdPort : HouseholdPort;
                port homeownerPort : HomeownerPort;
                part pvArray : PhotovoltaicArray;
                part energyhub : Energyhub;
                part lfpBatteryTower : LFPBatteryTower;
                part smartMeter : SmartMeter;
                part monitoringGateway : MonitoringGateway;
                part mobileApp : MobileApp;
                interface connect pvArray.dcOut to energyhub.dcIn {
                    doc /* DC string cabling from the roof array to the Energyhub's PV inputs. */
                }
                interface connect energyhub.dcBuffer to lfpBatteryTower.dcPort {
                    doc
                    /* DC battery cable: one connection carries both charging and discharging (DC-coupled storage). */
                }
                interface connect smartMeter.acPort to energyhub.acGrid {
                    doc /* AC power cable between the grid connection point and the Energyhub. */
                }
                interface connect smartMeter.statusOut to energyhub.statusIn {
                    doc
                    /* Meter data line (typically RS485/Modbus): the energy manager inside the Energyhub reads the grid exchange. */
                }
                interface connect smartMeter.statusOut to monitoringGateway.statusIn {
                    doc /* The same meter reading, fanned out to the monitoring gateway for recording. */
                }
                interface connect monitoringGateway.dataOut to mobileApp.dataIn {
                    doc /* Home network / internet link from the gateway to the homeowner's app. */
                }
                binding bind sunPort = pvArray.sunPort;
                binding bind gridPort = smartMeter.gridPort;
                binding bind householdPort = energyhub.householdPort;
                binding bind homeownerPort = mobileApp.homeownerPort;
            }
            part homePVSystem : 'HomePVSystem-PA' :> 'HPVS-Context'::systemContext.systemOfInterest {
                doc
                /* The physical system as installed. It subsets the system of interest of
                 * the context because every requirement has that system as its subject:
                 * only the whole system can satisfy them. Not satisfied, and reported as
                 * open results rather than filled with invented parts:
                 * beSafeAndLowMaintenance, complyWithElectricalSafety, meetPermitting,
                 * supportCommissioning, supportServicing. They trace to the commissioning
                 * and servicing use cases, which have no action flows, and to the absence
                 * of a protection or fault-handling function. */
                view homePVSystemView : DS_Views::SymbolicViews::iv;
                allocation allocate 'HPVS-LogicalArchitecture'::homePVSystem.photovoltaicGenerator to homePVSystem.pvArray;
                allocation allocate 'HPVS-LogicalArchitecture'::homePVSystem.inverter to homePVSystem.energyhub;
                allocation allocate 'HPVS-LogicalArchitecture'::homePVSystem.energyManager to homePVSystem.energyhub;
                allocation allocate 'HPVS-LogicalArchitecture'::homePVSystem.gridInterconnector to homePVSystem.energyhub;
                allocation allocate 'HPVS-LogicalArchitecture'::homePVSystem.accumulator to homePVSystem.lfpBatteryTower;
                allocation allocate 'HPVS-LogicalArchitecture'::homePVSystem.energyMeter to homePVSystem.smartMeter;
                allocation allocate 'HPVS-LogicalArchitecture'::homePVSystem.performanceTracker to homePVSystem.monitoringGateway;
                allocation allocate 'HPVS-LogicalArchitecture'::homePVSystem.performancePresenter to homePVSystem.mobileApp;
                satisfy generateFromSolar by homePVSystem;
                satisfy provideEveningAutonomy by homePVSystem;
                satisfy prioritizeSelfConsumption by homePVSystem;
                satisfy manageEnergyIntelligently by homePVSystem;
                satisfy drawGridOnlyOnShortfall by homePVSystem;
                satisfy exportSurplus by homePVSystem;
                satisfy disconnectOnGridOutage by homePVSystem;
                satisfy supplyReliably by homePVSystem;
                satisfy complyWithGridCode by homePVSystem;
                satisfy provideMonitoring by homePVSystem;
                satisfy achieveSelfSufficiency by homePVSystem;
            }
            view physicalArchitectureDiagram {
                expose 'HPVS-PhysicalArchitecture'::**;
                attribute depth = -1;
                attribute fileName = "HomePV-PhysicalArchitecture";
                attribute fileType = "PNG";
                attribute zoomLevel = 3.0;
                render Views::asInterconnectionDiagram;
            }
            view PhysicalArchitecture : DS_Views::SymbolicViews::gv;
        }
        view 'Logical to Physical Mapping' : DS_Views::SymbolicViews::gv;
    }
    view Index : DS_Views::SymbolicViews::gv;
}
library package SimplifiedSysMOD {
    enum def LevelKind :> ScalarValues::Integer {
        low = 1;
        medium = 2;
        high = 3;
    }
    enum def StakeholderCategoryKind {
        user;
        requirementOwner;
        expert;
        other;
    }
    part def Stakeholder {
        attribute risk : LevelKind;
        attribute effort : LevelKind;
        attribute priority = risk * effort;
        attribute category : StakeholderCategoryKind;
    }
}
